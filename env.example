# Cat Hub 環境変数サンプル。実際の値は.envではなくRenderのEnvironment Variablesに設定してください。

# --- 必須 ---
DATABASE_URL=postgresql://user:password@host:5432/dbname
SESSION_SECRET=change-this-to-a-long-random-string
NODE_ENV=production

# --- Cat Tube (YouTube Data API v3) ---
YOUTUBE_API_KEY=

# --- 管理者 ---
# カンマ区切りのユーザー名。DB上でis_admin=trueのユーザーも管理者として扱われます。
ADMIN_USERS=admin1,admin2

# --- Proxy ---
# カンマ区切りの許可ホスト。空の場合Proxy機能は利用不可になります。
# 例: example.com,*.example.org
ALLOWED_PROXY_HOSTS=

# --- Web VM ---
VM_ISO_URL=/vm/iso/linux.iso
VM_MAX_ISO_SIZE_MB=2048
VM_MEMORY_MB=512
VM_CPU_COUNT=1
VM_ENABLED=true
# VM用ネットワーク機能は本バージョンでは未実装です(README参照)。
VM_NETWORK_PROXY_ALLOWLIST=

# --- Render ---
# PORTはRenderが自動的に設定するため通常は指定不要です。
PORT=3000
